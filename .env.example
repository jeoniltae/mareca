# 이 파일을 .env.local로 복사해 값을 채운다. 실제 값은 커밋하지 않는다 (운영 값은 Vercel Dashboard에서 관리)
# NEXT_PUBLIC_ 접두어가 붙은 값만 브라우저 번들에 들어간다. 나머지는 서버·스크립트 전용

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 사이트 절대 주소 — canonical·OG·sitemap·JSON-LD에 쓴다 (로컬은 http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오톡 공유 — Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key

# Mux 영상 업로드 (클럽소식) — 서버 전용. Mux Dashboard > Settings > Access Tokens
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# RSS 수집 스크립트 (scripts/rss-sync.js) — 서버 전용. GitHub Actions Secrets에도 같은 이름으로 등록
# 서비스 키는 RLS를 우회하므로 절대 NEXT_PUBLIC_으로 노출하지 않는다
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# 카카오 OAuth (Supabase Dashboard에서 설정)
# https://supabase.com/dashboard/project/{project-id}/auth/providers

# 네이버 OAuth (Supabase Dashboard에서 설정)
# https://supabase.com/dashboard/project/{project-id}/auth/providers
